4a. Write a shell script that accepts two filenames as arguments , checks if
permission for thee files are identical or not.
#!/bin/bash
# Check if exactly two arguments are provided
if [ $# -ne 2 ]; then
echo "Usage: $0 <file1> <file2>"
exit 1
fi
file1=$1
file2=$2
# Check if both files exist
if [ ! -e "$file1" ]; then
echo "Error: '$file1' does not exist."
exit 1
fi
if [ ! -e "$file2" ]; then
echo "Error: '$file2' does not exist."
exit 1
fi
# Get permissions of both files in numeric format
perm1=$(stat -c "%a" "$file1")
perm2=$(stat -c "%a" "$file2")
echo "Permissions:"
echo "$file1: $perm1"
echo "$file2: $perm2"
# Compare permissions
if [ "$perm1" = "$perm2" ]; then
echo "Permissions are IDENTICAL."
else
echo "Permissions are DIFFERENT."
fi


4c. Shell script to count the number of files and directories in a given path.
#!/bin/bash
# Check if exactly one argument is provided
if [ $# -ne 1 ]; then
echo "Usage: $0 <directory_path>"
exit 1
fi
path=$1
# Check if the provided path is a directory
if [ ! -d "$path" ]; then
echo "Error: '$path' is not a valid directory."
exit 1
fi
# Count files (regular files)
file_count=$(find "$path" -type f | wc -l)
# Count directories
dir_count=$(find "$path" -type d | wc -l)
echo "In directory '$path':"
echo "Number of files: $file_count"
echo "Number of directories: $dir_count"


