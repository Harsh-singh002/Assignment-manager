6a. Shell script to check if a number is even or odd.
#!/bin/bash
# Check if exactly one argument is passed
if [ $# -ne 1 ]; then
echo "Usage: $0 <number>"
exit 1
fi
# Extract the number from command-line argument
num=$1
# Check if input is a valid integer using regex
if ! [[ "$num" =~ ^-?[0-9]+$ ]]; then
echo "Error: '$num' is not a valid integer."
exit 1
fi
# Use modulus operator to check even/odd
if [ $((num % 2)) -eq 0 ]; then
echo "$num is Even."
else
echo "$num is Odd."
fi


6b. Shell script to check whether a file exists and is
readable/writeable/executable.
#!/bin/bash
# Check if a file name was provided
if [ $# -ne 1 ]; then
echo "Usage: $0 <filename>"
exit 1
fi
file=$1
# Check if the file exists
if [ -e "$file" ]; then
echo "File '$file' exists."
# Check readability
if [ -r "$file" ]; then
echo "It is readable."
else
echo "It is NOT readable."
fi
# Check writability
if [ -w "$file" ]; then
echo "It is writable."
else
echo "It is NOT writable."
fi
# Check executability
if [ -x "$file" ]; then
echo "It is executable."
else
echo "It is NOT executable."
fi
else
exit 1
echo "File '$file' does NOT exist."
fi





7a. Shell script to print the multiplication table of a given number.
#!/bin/bash
# Check if the user provided exactly one argument
if [ $# -ne 1 ]; then
echo "Usage: $0 <number>"
exit 1
fi
num=$1
# Validate that input is a number (integer)
if ! [[ "$num" =~ ^-?[0-9]+$ ]]; then
echo "Error: '$num' is not a valid integer."
exit 1
fi
echo "Multiplication Table for $num:"
for i in {1..10}
do
result=$((num * i))
echo "$num x $i = $result"
done
7b. Shell script to find the factorial of a number using while loop.
#!/bin/bash
# Check if exactly one argument is passed
if [ $# -ne 1 ]; then
echo "Usage: $0 <non-negative-integer>"
exit 1
fi
num=$1
# Validate input (non-negative integer)
if ! [[ "$num" =~ ^[0-9]+$ ]]; then
echo "Error: '$num' is not a non-negative integer."
exit 1
fi
factorial=1
counter=1
while [ $counter -le $num ]
do
factorial=$((factorial * counter))
((counter++))
done
echo "Factorial of $num is: $factorial"
